    <string name="home_learn_more_title">Learn Shizako</string>
    <string name="home_learn_more_description">Learn how to develop with Shizako</string>

    <!-- Home - Adb permissions limited -->
    <string name="home_adb_is_limited_title">You need to take an extra step</string>
    <string name="home_adb_is_limited_description">"Your device manufacturer has restricted adb permissions and apps using Shizako will not work properly.

Usually, this limitation can be lifted by adjusting some options in \"Developer options\". Please read the help for details on how to do this.

You may need to restart Shizako for the operation to take effect."</string>

    <!-- Application management -->
    <string name="app_management_dialog_adb_is_limited_title">The permission of adb is limited</string>
    <string name="app_management_dialog_adb_is_limited_message"><![CDATA[It\'s highly possible that your device manufacturer limits the permission of adb.<p>There may be a solution for your system in <b><a href=\"%1$s\">this document</a></b>.]]></string>
    <string name="app_management_item_summary_requires_root">* requires Shizako runs with root</string>

    <!-- Terminal -->
    <string name="home_terminal_title">Use Shizako in terminal apps</string>
    <string name="home_terminal_description">Run commands through Shizako in terminal apps you like</string>

    <!-- One-click activation home card -->
    <string name="home_activation_title">One-click activation</string>
    <string name="home_activation_summary">Activate Brevent, Stopapp and more without a computer</string>
    <string name="home_activation_summary_not_running">Start Shizako first to use one-click activation</string>
    <string name="terminal_tutorial_1">First, Export files to any where you want. You will find two files, %1$s and %2$s.</string>
    <string name="terminal_tutorial_1_description">"If there are files with the same name in the selected folder, they will be deleted.

The export function uses SAF (Storage Access Framework). It's reported that MIUI breaks the functions of SAF. If you are using MIUI, you may have to extract the file from Shizako's apk or download from GitHub."</string>
    <string name="terminal_export_files">Export files</string>
    <string name="terminal_tutorial_2">Then, use any text editor to open and edit %1$s.</string>
    <string name="terminal_tutorial_2_description">For example, if you want to use Shizako in %1$s, you should replace %2$s with %3$s (%4$s is the package name of %1$s).</string>
    <string name="terminal_tutorial_3">Finally, move the files to somewhere where your terminal app can access, you will be able to use %1$s to run commands through Shizako.</string>
    <string name="terminal_tutorial_3_description">Some tips: grant execute permission to %1$s and add it to %2$s, you will able to use %1$s directly.</string>
    <string name="rish_description">With %1$s, in any terminal app, you can connect to and interact with the shell runs by Shizako. &lt;p>About the detailed usage %1$s, tap to view the document.</string>

